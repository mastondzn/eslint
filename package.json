{
  "name": "@mastondzn/eslint",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "description": "Maston's customizable ESLint config",
  "author": "Anthony Fu <anthonyfu117@hotmail.com> (https://github.com/antfu/)",
  "contributors": [
    "Maston (https://github.com/mastondzn)"
  ],
  "maintainers": [
    "Maston (https://github.com/mastondzn)"
  ],
  "license": "MIT",
  "homepage": "https://github.com/mastondzn/eslint",
  "repository": "https://github.com/mastondzn/eslint",
  "keywords": [
    "eslint-config"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "nr typegen && tsdown ./src/index.ts --unbundle --clean --dts",
    "dev": "npx @eslint/config-inspector --config eslint.config.ts",
    "build:inspector": "pnpm build && npx @eslint/config-inspector build --out-dir .eslint-config-inspector",
    "watch": "tsdown --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typegen": "tsx scripts/typegen.ts",
    "prepack": "nr build",
    "release": "bumpp",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.0",
    "eslint": "^10.4.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-react-refresh": "^0.5.7"
  },
  "peerDependenciesMeta": {
    "@eslint-react/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-better-tailwindcss": {
      "optional": true
    },
    "eslint-plugin-react-refresh": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/install-pkg": "^2.1.0",
    "@clack/prompts": "^1.8.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/markdown": "^8.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/utils": "^8.72.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-flat-config-utils": "^3.2.0",
    "eslint-merge-processors": "^2.0.0",
    "eslint-plugin-antfu": "^3.3.1",
    "eslint-plugin-command": "^4.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.4.4",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-toml": "^1.5.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-yml": "^3.10.0",
    "globals": "^17.14.0",
    "local-pkg": "^2.0.0",
    "toml-eslint-parser": "^1.0.3",
    "yaml-eslint-parser": "^2.1.0"
  },
  "devDependencies": {
    "@antfu/ni": "^30.6.0",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/config-inspector": "^3.5.0",
    "@types/node": "^25.9.9",
    "bumpp": "^12.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-typegen": "^2.3.2",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
